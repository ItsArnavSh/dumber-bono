FROM ubuntu:24.04

RUN apt-get update && apt-get install -y \
    build-essential cmake git curl ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN git clone https://github.com/ggerganov/whisper.cpp.git . \
    && cmake -B build -DWHISPER_BUILD_SERVER=ON \
    && cmake --build build --config Release --target whisper-server

# Entrypoint script
COPY <<EOF /entrypoint.sh
#!/bin/sh
if [ ! -f /models/ggml-base.en.bin ]; then
    ./models/download-ggml-model.sh base.en /models
fi
./build/bin/whisper-server --host 0.0.0.0 --port 8080 -m /models/ggml-base.en.bin
EOF
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
